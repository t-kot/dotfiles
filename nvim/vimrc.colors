syntax enable
set termguicolors

" 256color settings
" colorscheme tender
"set t_Co=256
if &term =~ 'xterm-256color' || $TERM =~ "xterm-color"
  highlight Normal ctermbg=none
else
  highlight CursorLine cterm=underline ctermbg=darkgrey guibg=black
  highlight CursorColumn cterm=none ctermbg=darkgrey guibg=black
endif

" Keep the terminal (iTerm2) background transparent. With termguicolors the
" GUI background (guibg) is what gets painted, so ctermbg=none alone is not
" enough — clear guibg too. Re-apply on every ColorScheme so it survives
" colorscheme changes.
function! s:transparent_bg() abort
  highlight Normal      guibg=NONE ctermbg=NONE
  highlight NonText     guibg=NONE ctermbg=NONE
  highlight EndOfBuffer guibg=NONE ctermbg=NONE
  highlight SignColumn  guibg=NONE ctermbg=NONE
  highlight LineNr      guibg=NONE ctermbg=NONE
endfunction

augroup TransparentBackground
  autocmd!
  autocmd ColorScheme * call s:transparent_bg()
augroup END

call s:transparent_bg()
